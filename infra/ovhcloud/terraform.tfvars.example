# Copy to terraform.tfvars (never committed) and fill in. See README.md, step 2.
project_id = "<Public Cloud project id, 32 hex characters>"
region     = "EU-WEST-PAR"

# Ubuntu 24.04 image and b3-16 flavor IDs in that region.
image_id  = "<image id>"
flavor_id = "<flavor id>"

ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

# Your public IP for SSH, then every IP allowed to open the demo UIs.
admin_cidr = "203.0.113.10/32"
demo_cidrs = ["203.0.113.10/32"]
