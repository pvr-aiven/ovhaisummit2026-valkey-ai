# ---- Secrets : aucun fichier .env, clé ou certificat n'est versionné ----------------------
# Les exemples (*.env.example) sont versionnés ; `make` crée env/local*.env automatiquement.
*.env
.env
.env.*
!*.env.example
secrets.*
!secrets.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
.netrc
demos/*/certs/*
!demos/*/certs/.gitkeep

# ---- Données téléchargées ou générées par les démos (make prepare les recrée) --------------
demos/*/data/

# ---- Aperçus et fichiers temporaires du générateur de slides ------------------------------
*_preview/
~$*

# ---- Python, outils, système ---------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.DS_Store
.idea/
.vscode/
