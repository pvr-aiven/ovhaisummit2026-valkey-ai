# Cible locale : Valkey 9.1 dans Docker + modèles OVHcloud AI Endpoints (connexion Internet nécessaire)
# La clé AI Endpoints se met dans env/secrets.env (voir secrets.env.example)
DEMO_TARGET=local
VALKEY_URL=redis://valkey:6379
EMBED_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
EMBED_MODEL=bge-m3
CHAT_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
CHAT_MODEL=Mistral-Small-3.2-24B-Instruct-2506
