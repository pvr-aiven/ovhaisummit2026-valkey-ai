# Plan B sans Internet : Valkey 9.1 dans Docker + modèles servis par Ollama sur le portable
# Prérequis : application Ollama installée, puis `make ollama`.
# IMPORTANT : lancer Ollama avec un contexte de 8 192 tokens, sinon le prompt RAG est tronqué sans erreur :
#   macOS : launchctl setenv OLLAMA_CONTEXT_LENGTH 8192  puis relancer l'application Ollama
DEMO_TARGET=local-offline
VALKEY_URL=redis://valkey:6379
# Index séparé : des vecteurs d'un autre serveur ne doivent pas être mélangés avec ceux d'AI Endpoints
INDEX_NAME=idx:kb_offline
KEY_PREFIX=chunk_off:
EMBED_BASE_URL=http://host.docker.internal:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3
CHAT_BASE_URL=http://host.docker.internal:11434/v1
CHAT_API_KEY=ollama
# Mistral 7B (4 Go). Plus lent mais meilleur en français : mistral-small3.2 (15 Go)
CHAT_MODEL=mistral
# Moins d'extraits : prompt plus court, réponse plus rapide sur un portable
TOP_K=3
