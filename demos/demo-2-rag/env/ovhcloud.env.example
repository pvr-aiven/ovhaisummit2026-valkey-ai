# Cible OVHcloud : Managed Valkey 9.1 + AI Endpoints (copier vers env/ovhcloud.env et compléter)
DEMO_TARGET=ovhcloud
# Control Panel > Public Cloud > Databases > service Valkey (TLS obligatoire : rediss://)
VALKEY_URL=rediss://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT
# VALKEY_CA_CERT=/certs/ovh-ca.pem   (essayer d'abord sans)
EMBED_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
EMBED_MODEL=bge-m3
CHAT_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
CHAT_MODEL=Mistral-Small-3.2-24B-Instruct-2506
# Caractères spéciaux du mot de passe : les encoder dans l'URL (@ -> %40, : -> %3A, / -> %2F) et éviter $
