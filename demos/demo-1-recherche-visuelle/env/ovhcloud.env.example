# Cible OVHcloud Managed Valkey 9.1 (copier vers env/ovhcloud.env et compléter)
# Control Panel > Public Cloud > Databases > votre service Valkey > « Informations générales » / « Utilisateurs »
DEMO_TARGET=ovhcloud
# TLS obligatoire : schéma rediss://
VALKEY_URL=rediss://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT
# Optionnel : CA téléchargé depuis le Control Panel, déposé dans ./certs/
# VALKEY_CA_CERT=/certs/ovh-ca.pem   (essayer d'abord sans)
# Caractères spéciaux du mot de passe : les encoder dans l'URL (@ -> %40, : -> %3A, / -> %2F) et éviter $
