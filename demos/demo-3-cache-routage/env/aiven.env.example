# Cible Aiven : Aiven for Valkey + AI Gateway (en attente). Copier vers env/aiven.env et compléter.
DEMO_TARGET=aiven
VALKEY_URL=rediss://default:MOT_DE_PASSE@HOTE.aivencloud.com:PORT
VALKEY_CA_CERT=/certs/aiven-ca.pem
# En attendant l'AI Gateway : modèles AI Endpoints. Ensuite, remplacer URL, clés et noms de modèles,
# et garder SIMPLE_PRICE_MODEL / COMPLEX_PRICE_MODEL (ou ajouter les prix de l'AI Gateway dans data/prices.json).
EMBED_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
EMBED_MODEL=bge-m3
CHAT_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
SIMPLE_MODEL=Mistral-Small-3.2-24B-Instruct-2506
COMPLEX_MODEL=gpt-oss-120b
# CHAT_BASE_URL=https://<ai-gateway-aiven>/v1
# CHAT_API_KEY=<clé AI Gateway>
