# Plan B sans Internet : Valkey 9.1 dans Docker + modèles servis par Ollama sur le portable
# Prérequis : `make ollama` (bge-m3, mistral, gpt-oss:20b ~ 18 Go au total)
DEMO_TARGET=local-offline
VALKEY_URL=redis://valkey:6379
# Index et clés séparés : les vecteurs d'Ollama ne se mélangent pas avec ceux d'AI Endpoints
CACHE_INDEX=idx:cache_offline
CACHE_PREFIX=cache_off:
EXACT_PREFIX=exact_off:
ROUTE_INDEX=idx:route_offline
ROUTE_PREFIX=route_off:
STATS_KEY=stats:demo3_offline
EMBED_BASE_URL=http://host.docker.internal:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3
CHAT_BASE_URL=http://host.docker.internal:11434/v1
CHAT_API_KEY=ollama
SIMPLE_MODEL=mistral
COMPLEX_MODEL=gpt-oss:20b
# Le compteur chiffre les appels « comme sur AI Endpoints »
SIMPLE_PRICE_MODEL=Mistral-Small-3.2-24B-Instruct-2506
COMPLEX_PRICE_MODEL=gpt-oss-120b
